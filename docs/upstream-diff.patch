@@ -0,0 +1,763 @@
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ *
+ * Profile selection screen styles
+ */
+
+#profileSelection {
+    position: absolute;
+    top: 0;
+    left: 0;
+    width: 100%;
+    height: 100%;
+    background-color: #101010;
+    display: none;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    z-index: 100;
+}
+
+#profileSelection h1 {
+    font-size: 2.5rem;
+    margin-bottom: 1.5rem;
+    color: #fff;
+    font-weight: 300;
+}
+
+#profileGrid {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: center;
+    align-items: flex-start;
+    max-width: 80%;
+    gap: 2rem;
+    padding: 1rem;
+}
+
+.profile-column {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    gap: 0.6rem;
+    width: 180px;
+    box-sizing: border-box;
+}
+
+.profile-sub-actions {
+    display: none;
+    flex-direction: column;
+    gap: 0.4rem;
+    width: 100%;
+    box-sizing: border-box;
+}
+
+.profile-column.is-selected .profile-sub-actions {
+    display: flex;
+}
+
+.profile-column.is-selected:not(.has-actions) .profile-sub-actions {
+    display: none;
+}
+
+.profile-column.is-selected.has-actions .profile-sub-actions {
+    display: flex;
+    padding: 0.5rem 0.6rem 0;
+    border-top: 1px solid #2c2c2c;
+    gap: 0.35rem;
+}
+
+.profile-column.is-selected.has-actions {
+    background: #1a1a1a;
+    border: 3px solid #00A4DC;
+    border-radius: 0.6rem;
+    box-shadow: 0 0 0 4px rgba(0, 164, 220, 0.25);
+    gap: 0;
+    padding-bottom: 0.6rem;
+    overflow: hidden;
+}
+
+.profile-sub-actions-title {
+    font-size: 0.75rem;
+    color: #9a9a9a;
+    text-align: left;
+    margin-bottom: 0.15rem;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+
+.profile-action-btn {
+    width: 100%;
+    margin: 0;
+    padding: 0.45rem 0.75rem;
+    font-size: 0.85rem;
+    font-weight: 500;
+    text-align: left;
+    background-color: #262626;
+    color: #ddd;
+    border: 2px solid transparent;
+    border-radius: 0.3rem;
+    cursor: pointer;
+    transition: all 0.15s ease;
+    outline: none;
+    box-sizing: border-box;
+}
+
+.profile-action-auto.is-on {
+    border-color: #00A4DC;
+    color: #00A4DC;
+}
+
+.profile-action-btn:hover,
+.profile-action-btn:focus,
+.profile-action-auto.is-on:hover,
+.profile-action-auto.is-on:focus {
+    border-color: #00A4DC;
+    background-color: #00A4DC;
+    color: #fff;
+    outline: none;
+}
+
+.profile-action-btn-danger:hover,
+.profile-action-btn-danger:focus {
+    background-color: #c62828;
+    border-color: #ff8a80;
+    color: #fff;
+}
+
+.profile-card {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    width: 180px;
+    padding: 1.5rem 1rem;
+    background-color: #1a1a1a;
+    border-radius: 0.5rem;
+    cursor: pointer;
+    transition: all 0.2s ease-in-out;
+    outline: none;
+    border: 3px solid transparent;
+    position: relative;
+    box-sizing: border-box;
+}
+
+.profile-card:hover,
+.profile-card:focus {
+    background-color: #252525;
+    border-color: #00A4DC;
+    transform: scale(1.05);
+}
+
+.profile-card:focus {
+    box-shadow: 0 0 0 4px rgba(0, 164, 220, 0.3);
+}
+
+.profile-column.is-selected.has-actions .profile-card,
+.profile-column.is-selected.has-actions .profile-card:hover {
+    width: 100%;
+    border-color: transparent;
+    transform: none;
+    box-shadow: none;
+    border-radius: 0;
+}
+
+.profile-column.is-selected.has-actions .profile-card:focus {
+    width: 100%;
+    background-color: #252525;
+    border-color: transparent;
+    transform: none;
+    border-radius: 0;
+    box-shadow: inset 0 0 0 2px #00A4DC;
+}
+
+.profile-avatar {
+    width: 120px;
+    height: 120px;
+    border-radius: 50%;
+    overflow: hidden;
+    margin-bottom: 1rem;
+    background-color: #292929;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+}
+
+.profile-avatar img {
+    width: 100%;
+    height: 100%;
+    object-fit: cover;
+}
+
+.profile-avatar-placeholder {
+    font-size: 3rem;
+    color: #00A4DC;
+    font-weight: bold;
+}
+
+.profile-card-add .profile-avatar-placeholder {
+    font-size: 4rem;
+    color: #666;
+}
+
+.profile-card-add:hover .profile-avatar-placeholder,
+.profile-card-add:focus .profile-avatar-placeholder {
+    color: #00A4DC;
+}
+
+.profile-name {
+    font-size: 1.2rem;
+    color: #fff;
+    text-align: center;
+    max-width: 100%;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+
+.profile-lock {
+    position: absolute;
+    top: 0.6rem;
+    right: 0.6rem;
+    width: 30px;
+    height: 30px;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    border-radius: 50%;
+    background: rgba(0, 164, 220, 0.15);
+    color: #00A4DC;
+    opacity: 1;
+    font-size: 0;
+    line-height: 0;
+}
+
+.profile-card:focus .profile-lock {
+    background: #00A4DC;
+    color: #fff;
+}
+
+.profile-remembered {
+    font-size: 0.75rem;
+    color: #00A4DC;
+    margin-top: 0.5rem;
+}
+
+#profileServerName {
+    font-size: 1rem;
+    color: #888;
+    margin-bottom: 2rem;
+}
+
+#profileError {
+    position: fixed;
+    bottom: 2rem;
+    left: 50%;
+    transform: translateX(-50%);
+    background-color: #c62828;
+    color: #fff;
+    padding: 1rem 2rem;
+    border-radius: 0.5rem;
+    display: none;
+    z-index: 200;
+}
+
+#profileLoading {
+    position: fixed;
+    top: 0;
+    left: 0;
+    width: 100%;
+    height: 100%;
+    background-color: rgba(16, 16, 16, 0.9);
+    display: none;
+    align-items: center;
+    justify-content: center;
+    z-index: 150;
+}
+
+#profileLoading .spinner {
+    width: 60px;
+    height: 60px;
+    border: 4px solid #333;
+    border-top-color: #00A4DC;
+    border-radius: 50%;
+    animation: spin 1s linear infinite;
+}
+
+@keyframes spin {
+    to {
+        transform: rotate(360deg);
+    }
+}
+
+/* PIN Entry Overlay */
+#pinOverlay,
+#manualLoginOverlay {
+    position: fixed;
+    top: 0;
+    left: 0;
+    width: 100%;
+    height: 100%;
+    background-color: rgba(16, 16, 16, 0.95);
+    display: none;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    z-index: 200;
+}
+
+.pin-container,
+.manual-login-container {
+    background-color: #1a1a1a;
+    padding: 2.5rem;
+    border-radius: 0.5rem;
+    text-align: center;
+    min-width: 400px;
+}
+
+.pin-container h2,
+.manual-login-container h2 {
+    font-size: 1.5rem;
+    margin-bottom: 0.5rem;
+    color: #fff;
+    font-weight: 400;
+}
+
+#pinUserName {
+    font-size: 1.2rem;
+    color: #00A4DC;
+    margin-bottom: 1.5rem;
+}
+
+#pinInput,
+#manualUsername,
+#manualPassword {
+    width: 100%;
+    padding: 1rem;
+    font-size: 1.5rem;
+    text-align: center;
+    background-color: #292929;
+    border: 2px solid #333;
+    border-radius: 0.3rem;
+    color: #fff;
+    margin-bottom: 1rem;
+    transition: border-color 0.2s;
+    box-sizing: border-box;
+}
+
+#pinInput:focus,
+#manualUsername:focus,
+#manualPassword:focus {
+    outline: none;
+    border-color: #00A4DC;
+}
+
+#manualUsername[readonly],
+#manualPassword[readonly],
+#pinInput[readonly] {
+    cursor: pointer;
+}
+
+#pinError,
+#manualLoginError {
+    color: #ef5350;
+    font-size: 1rem;
+    margin-bottom: 1rem;
+    display: none;
+}
+
+.pin-buttons,
+.manual-login-buttons {
+    display: flex;
+    gap: 1rem;
+    justify-content: center;
+    margin-top: 1rem;
+}
+
+.pin-buttons button,
+.manual-login-buttons button {
+    width: auto;
+    margin: 0;
+    padding: 0.75rem 2rem;
+    font-size: 1rem;
+    border: none;
+    border-radius: 0.3rem;
+    cursor: pointer;
+    transition: all 0.2s;
+}
+
+.pin-buttons button:first-child,
+.manual-login-buttons button:first-child {
+    background-color: #00A4DC;
+    color: #fff;
+}
+
+.pin-buttons button:last-child,
+.manual-login-buttons button:last-child {
+    background-color: #333;
+    color: #fff;
+}
+
+.pin-buttons button:focus,
+.manual-login-buttons button:focus {
+    outline: 2px solid #00A4DC;
+    outline-offset: 2px;
+}
+
+.manual-qc-divider {
+    color: #888;
+    font-size: 0.9rem;
+    margin-top: 0.75rem;
+}
+
+.manual-qc-btn {
+    width: 100%;
+    margin: 0.75rem 0 0 0;
+    padding: 0.75rem 1.5rem;
+    font-size: 1rem;
+    background-color: #292929;
+    color: #ddd;
+    border: 2px solid #444;
+    border-radius: 0.3rem;
+    cursor: pointer;
+    transition: all 0.2s;
+    box-sizing: border-box;
+}
+
+.manual-qc-btn:hover,
+.manual-qc-btn:focus {
+    outline: none;
+    border-color: #00A4DC;
+    background-color: #333;
+    color: #fff;
+    box-shadow: 0 0 0 2px rgba(0, 164, 220, 0.35);
+}
+
+.pin-hint {
+    font-size: 0.9rem;
+    color: #888;
+    margin-top: 1rem;
+}
+
+/* Back button */
+#profileBackBtn {
+    position: absolute;
+    top: 2rem;
+    left: 2rem;
+    width: auto;
+    margin: 0;
+    padding: 0.75rem 1.5rem;
+    background-color: #292929;
+    border: none;
+    border-radius: 0.3rem;
+    color: #fff;
+    font-size: 1rem;
+    line-height: 1.2;
+    display: inline-flex;
+    align-items: center;
+    cursor: pointer;
+    transition: all 0.2s;
+}
+
+#profileBackBtn:hover,
+#profileBackBtn:focus {
+    background-color: #00A4DC;
+    outline: none;
+}
+
+/* Quick Connect Overlay */
+#quickConnectOverlay {
+    position: fixed;
+    top: 0;
+    left: 0;
+    width: 100%;
+    height: 100%;
+    background-color: rgba(16, 16, 16, 0.95);
+    display: none;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    z-index: 200;
+}
+
+.quickconnect-container {
+    background-color: #1a1a1a;
+    padding: 2.5rem 3rem;
+    border-radius: 0.5rem;
+    text-align: center;
+    min-width: 450px;
+    max-width: 90%;
+}
+
+.quickconnect-container h2 {
+    font-size: 1.8rem;
+    margin-bottom: 1.5rem;
+    color: #fff;
+    font-weight: 400;
+}
+
+.quickconnect-code-wrapper {
+    background-color: #292929;
+    padding: 1.5rem 2rem;
+    border-radius: 0.5rem;
+    margin-bottom: 1rem;
+}
+
+#quickConnectCode {
+    font-size: 3rem;
+    font-weight: bold;
+    color: #00A4DC;
+    letter-spacing: 0.5rem;
+    font-family: monospace;
+}
+
+#quickConnectStatus {
+    font-size: 1.1rem;
+    color: #888;
+    margin-bottom: 1.5rem;
+}
+
+#quickConnectError {
+    color: #ef5350;
+    font-size: 1rem;
+    margin-bottom: 1rem;
+    display: none;
+}
+
+.quickconnect-instructions {
+    text-align: left;
+    background-color: #252525;
+    padding: 1rem 1.5rem;
+    border-radius: 0.3rem;
+    margin-bottom: 1.5rem;
+}
+
+.quickconnect-instructions p {
+    color: #aaa;
+    font-size: 0.95rem;
+    margin: 0.5rem 0;
+    line-height: 1.4;
+}
+
+.quickconnect-buttons {
+    display: flex;
+    gap: 1rem;
+    justify-content: center;
+}
+
+.quickconnect-buttons button {
+    width: auto;
+    margin: 0;
+    padding: 0.75rem 2rem;
+    font-size: 1rem;
+    border: none;
+    border-radius: 0.3rem;
+    cursor: pointer;
+    transition: all 0.2s;
+    background-color: #333;
+    color: #fff;
+}
+
+.quickconnect-buttons button:hover,
+.quickconnect-buttons button:focus {
+    background-color: #00A4DC;
+    outline: none;
+}
+
+/* Numeric PIN Pad Overlay */
+#numericPinOverlay {
+    position: fixed;
+    top: 0;
+    left: 0;
+    width: 100%;
+    height: 100%;
+    background-color: rgba(16, 16, 16, 0.96);
+    display: none;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    z-index: 300;
+}
+
+.num-pin-container {
+    background-color: #1a1a1a;
+    padding: 2rem 2.5rem;
+    border-radius: 0.75rem;
+    text-align: center;
+    min-width: 380px;
+    max-width: 90%;
+    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.6);
+}
+
+#numPinTitle {
+    font-size: 1.6rem;
+    margin: 0 0 0.4rem 0;
+    color: #fff;
+    font-weight: 400;
+}
+
+#numPinSubtitle {
+    font-size: 1rem;
+    color: #00A4DC;
+    margin-bottom: 1.25rem;
+    min-height: 1.2rem;
+}
+
+#numPinDots {
+    display: flex;
+    justify-content: center;
+    gap: 1rem;
+    margin-bottom: 1rem;
+}
+
+.num-pin-dot {
+    width: 18px;
+    height: 18px;
+    border-radius: 50%;
+    border: 2px solid #555;
+    background-color: transparent;
+    transition: all 0.15s ease;
+}
+
+.num-pin-dot.filled {
+    background-color: #00A4DC;
+    border-color: #00A4DC;
+    transform: scale(1.1);
+}
+
+@keyframes numPinShake {
+    0%, 100% { transform: translateX(0); }
+    20%, 60% { transform: translateX(-8px); }
+    40%, 80% { transform: translateX(8px); }
+}
+
+#numPinDots.shake {
+    animation: numPinShake 0.35s ease;
+}
+
+#numPinError {
+    color: #ef5350;
+    font-size: 0.95rem;
+    min-height: 1.2rem;
+    margin-bottom: 0.75rem;
+    display: none;
+}
+
+#numPinPad {
+    display: grid;
+    grid-template-columns: repeat(3, 88px);
+    grid-gap: 0.75rem;
+    justify-content: center;
+    margin: 0.5rem auto 1.25rem auto;
+}
+
+.num-pin-key {
+    width: 88px;
+    height: 64px;
+    margin: 0;
+    font-size: 1.6rem;
+    font-weight: 500;
+    color: #fff;
+    background-color: #292929;
+    border: 2px solid transparent;
+    border-radius: 0.5rem;
+    cursor: pointer;
+    transition: all 0.15s ease;
+    outline: none;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+}
+
+.num-pin-key-fn {
+    font-size: 1.25rem;
+    color: #bbb;
+    background-color: #222;
+}
+
+.num-pin-key:hover,
+.num-pin-key:focus {
+    background-color: #333;
+    border-color: #00A4DC;
+    box-shadow: 0 0 0 3px rgba(0, 164, 220, 0.35);
+    color: #fff;
+    transform: scale(1.04);
+}
+
+#numPinActions {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 0.75rem;
+    justify-content: center;
+    margin-top: 0.5rem;
+}
+
+.num-pin-action {
+    width: auto;
+    margin: 0;
+    padding: 0.65rem 1.25rem;
+    font-size: 0.95rem;
+    border: 2px solid transparent;
+    border-radius: 0.4rem;
+    cursor: pointer;
+    background-color: #333;
+    color: #fff;
+    transition: all 0.15s ease;
+    outline: none;
+}
+
+.num-pin-action-primary {
+    border-color: rgba(0, 164, 220, 0.65);
+    background-color: #22353f;
+}
+
+.num-pin-action-danger {
+    background-color: #4a1f1f;
+    color: #ffcdd2;
+}
+
+.num-pin-action:hover,
+.num-pin-action:focus {
+    border-color: #00A4DC;
+    box-shadow: 0 0 0 3px rgba(0, 164, 220, 0.35);
+    background-color: #00A4DC;
+    color: #fff;
+}
+
+.num-pin-action-danger:hover,
+.num-pin-action-danger:focus {
+    background-color: #c62828;
+    border-color: #ff8a80;
+    color: #fff;
+}
+
+/* Responsive adjustments */
+@media (max-width: 1280px) {
+    .profile-column {
+        width: 150px;
+    }
+
+    .profile-card {
+        width: 150px;
+        padding: 1rem 0.75rem;
+    }
+
+    .profile-avatar {
+        width: 100px;
+        height: 100px;
+    }
+
+    .profile-name {
+        font-size: 1rem;
+    }
+
+    .quickconnect-container {
+        min-width: 350px;
+    }
+
+    #quickConnectCode {
+        font-size: 2.5rem;
+    }
+}
