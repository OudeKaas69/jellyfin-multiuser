+        img.src = normalizeUrl(this.currentServer.baseurl + '/Users/' + user.Id +
+            '/Images/Primary?tag=' + user.PrimaryImageTag + '&quality=90&maxHeight=200');
+        img.alt = user.Name;
+        img.onerror = function () {
